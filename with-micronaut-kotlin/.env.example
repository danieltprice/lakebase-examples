# Set these before running (e.g. from a script that fetches a Lakebase token).
# LAKEBASE_JDBC_URL=jdbc:postgresql://<host>:5432/databricks_postgres?sslmode=require
# LAKEBASE_USERNAME=<DATABRICKS_CLIENT_ID>
# LAKEBASE_PASSWORD=<short-lived-token>

# For the token script you also need:
# DATABRICKS_HOST=your-workspace.cloud.databricks.com
# DATABRICKS_CLIENT_ID=your-service-principal-client-id
# DATABRICKS_CLIENT_SECRET=your-service-principal-secret
# LAKEBASE_ENDPOINT=projects/.../endpoints/...
# LAKEBASE_HOST=your-endpoint.database.<region>.cloud.databricks.com
# LAKEBASE_PORT=5432
# LAKEBASE_DATABASE=databricks_postgres
