# For Lakebase: set POSTGRES_URL to a URL built from a short-lived token (see README).
# POSTGRES_URL=postgresql://<client_id>:<token>@<host>:5432/<db>?sslmode=require
POSTGRES_URL=

# Socket connection (use your Lakebase endpoint host)
LAKEBASE_HOST=your-endpoint.database.<region>.cloud.databricks.com
LAKEBASE_PORT=5432
