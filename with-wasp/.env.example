# Wasp reads DATABASE_URL from .env.server. For Lakebase, set DATABASE_URL to a
# Postgres URL built from a short-lived token (e.g. run a script that calls
# Databricks OIDC + postgres/credentials and prints the URL).
#
# Required env (for token script): DATABRICKS_HOST, DATABRICKS_CLIENT_ID,
# DATABRICKS_CLIENT_SECRET, LAKEBASE_ENDPOINT, LAKEBASE_HOST, LAKEBASE_PORT, LAKEBASE_DATABASE
# Then: DATABASE_URL="postgresql://<user>:<token>@<LAKEBASE_HOST>:<port>/<db>?sslmode=require"

DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require"
